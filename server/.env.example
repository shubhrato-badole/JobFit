# JobFit: server configuration
# Copy to server/.env and fill in the values. Never commit the real .env file.

# ───────────────────────── Required ─────────────────────────

# Google AI Studio keys: https://aistudio.google.com/apikey  (the two can be the same key)
GEMINI_API_KEY=
GEMINI_CHATBOT_KEY=

# RapidAPI key with a JSearch subscription: https://rapidapi.com/
RAPID_API_KEY=

# JWT secrets (note: the spelling matches the code). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_ACESSTOKEN=
JWT_SECRET_REFRESHTOKEN=

# Brevo SMTP relay credentials (verification and password-reset emails)
EMAIL_USER=
EMAIL_PASS=

# Where the web app is served. Used in emails and the Google sign-in redirect.
#   Docker Compose:    http://localhost
#   npm run dev:       http://localhost:5173
CLIENT_URL=http://localhost

# Allowed browser origins, comma-separated (same choices as CLIENT_URL)
CORS_ORIGINS=http://localhost

# ───────────────── Database and cache ─────────────────
# Docker Compose overrides DATABASE_URL and REDIS_URL for you.
# For a local API with `docker compose up -d postgres redis`, these defaults work:
DATABASE_URL=postgresql://postgres:password@localhost:5433/jobfit
REDIS_URL=redis://localhost:6380

# Local Postgres and Redis have no SSL/TLS. For managed services, DELETE these two lines.
DATABASE_SSL=false
REDIS_TLS=false

# ───────────────────────── Optional ─────────────────────────

PORT=3000

# Google sign-in. Authorized redirect URI must match GOOGLE_CALLBACK_URL.
#   Docker Compose:  http://localhost/api/auth/google/callback
#   npm run dev:     http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback
